function resultadoNav(r) { return r.ok ? `ok. Na tela agora: ${r.descricao} Não repita nem reformule o que já disse; continue de onde parou.` : `erro: ${r.erro}`; }
function executaFerramentas(calls) {
  const respostas = [];
  for (const fc of calls) {
    let resultado = "ok";
    const a = fc.args || {};
    try {
      log(`ferramenta chamada: ${fc.name}`);
      if (fc.name === "abrir_secao") resultado = resultadoNav(executar({ acao: "abrir_secao", secao: a.secao, guiado: true }));
      else if (fc.name === "abrir_procedimento") resultado = resultadoNav(executar({ acao: "abrir_procedimento", procedimento: a.procedimento, guiado: true }));
      else if (fc.name === "ver_pagina") resultado = "Na tela agora: " + descricao();
      else if (fc.name === "sugerir_opcoes") { const s = mostraSugestoes(a.opcoes); resultado = s ? `ok. Sugestões na tela: ${s}. Aguarde a resposta; não repita o que já disse.` : "erro: nenhuma opção válida"; }
      else if (fc.name === "destacar_bloco") { const r = destacaBloco(a.bloco); resultado = r === "ok" ? "ok. Continue explicando; não repita o que já disse." : r; }
      else if (fc.name === "registrar_interesse") resultado = registraInteresse(a);
      else if (fc.name === "preparar_whatsapp") resultado = preparaWhatsapp(a);
      else resultado = "funcao_desconhecida";
    } catch (e) { resultado = "erro"; log("erro na ferramenta: " + e.message); }
    respostas.push({ id: fc.id, name: fc.name, response: { result: resultado } });
  }
  if (ws && ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify({ toolResponse: { functionResponses: respostas } }));
}

/* ---------- Voz ---------- */
let ws = null, micStream = null, micCtx = null, playCtx = null, node = null;
let nextTime = 0, sources = [], ready = false, running = false;
let queue = Promise.resolve();
let visualLevel = 0;

function log(msg) {
  const t = new Date().toLocaleTimeString("pt-BR");
  $("log").textContent += `[${t}] ${msg}\n`;
}
function setStatus(t) {
  $("status").textContent = t;
  const p = $("clara-pill");
  if (p) { p.textContent = t.replace(/ — .*/, ""); p.hidden = /^(Parad[oa]|Conversa encerrada|Erro)/.test(t); }
