function resetaVisualizador() {
  document.documentElement.style.setProperty("--voice-scale", "1");
  document.documentElement.style.setProperty("--nivel", "0");
  $("voice-visualizer").classList.remove("is-active", "falando");
  $("voice-visualizer").querySelectorAll(".voice-wave i").forEach((bar) => { bar.style.height = "5px"; });
}

function atualizaVisualizador(buffer) {
  if (sources.length) return; // enquanto a Clara fala, a esfera acompanha a voz dela (animaFala)
  const samples = new Int16Array(buffer);
  let soma = 0;
  for (let i = 0; i < samples.length; i++) { const v = samples[i] / 32768; soma += v * v; }
  const rms = Math.sqrt(soma / Math.max(1, samples.length));
  // Aumenta a amplitude visível sem alterar o áudio enviado ao modelo.
  visualLevel = Math.min(1, Math.max(0, rms * 10));
  document.documentElement.style.setProperty("--voice-scale", (1 + visualLevel * 0.28).toFixed(3));
  const vis = $("voice-visualizer");
  vis.classList.toggle("is-active", visualLevel > 0.035);
  vis.querySelectorAll(".voice-wave i").forEach((bar, index) => {
    const shape = [0.35, 0.65, 1, 0.52, 0.85, 0.42, 0.72][index] || 0.5;
    bar.style.height = `${4 + visualLevel * 30 * shape}px`;
  });
}

const WORKLET = `
class Cap extends AudioWorkletProcessor {
  constructor() { super(); this.ratio = sampleRate / 16000; this.pos = 0; this.buf = []; }
  process(inputs) {
    const ch = inputs[0][0];
    if (!ch) return true;
    let i = this.pos;
    for (; i < ch.length; i += this.ratio) {
      const idx = Math.floor(i), frac = i - idx;
      const a = ch[idx], b = idx + 1 < ch.length ? ch[idx + 1] : a;
      this.buf.push(a + (b - a) * frac);
    }
    this.pos = i - ch.length;
    while (this.buf.length >= 640) {
      const s = this.buf.splice(0, 640);
      const out = new Int16Array(640);
      for (let k = 0; k < 640; k++) out[k] = Math.max(-1, Math.min(1, s[k])) * 0x7fff;
      this.port.postMessage(out.buffer, [out.buffer]);
    }
    return true;
  }
}
registerProcessor("cap", Cap);
`;

function toB64(buf) {
  const u = new Uint8Array(buf);
  let s = "";
  for (let i = 0; i < u.length; i++) s += String.fromCharCode(u[i]);
  return btoa(s);
}

function tocaAudio(b64) {
  const bin = atob(b64);
  const bytes = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
  const dv = new DataView(bytes.buffer);
  const n = Math.floor(bytes.length / 2);
  const f32 = new Float32Array(n);
  for (let i = 0; i < n; i++) f32[i] = dv.getInt16(i * 2, true) / 32768;
  const buf = playCtx.createBuffer(1, n, 24000);
  buf.copyToChannel(f32, 0);
  const src = playCtx.createBufferSource();
  src.buffer = buf;
  src.connect(saidaAnalisador());
  const t = Math.max(playCtx.currentTime + 0.02, nextTime);
  src.start(t);
  modeloFalou = true;
  setStatus("Clara falando");
  nextTime = t + buf.duration;
  if (!sources.length) aoComecarAFalar();
  sources.push(src);
  src.onended = () => {
    sources = sources.filter((s) => s !== src);
    if (!sources.length && running) setStatus("Clara ouvindo");
  };
}
function paraAudio() {
  sources.forEach((s) => { try { s.stop(); } catch (e) {} });
  sources = [];
  nextTime = 0;
}

function trata(msg) {
  if (msg.toolCall) { executaFerramentas(msg.toolCall.functionCalls || []); return; }
  if (msg.toolCallCancellation) { log("toolCallCancellation recebido"); return; }
  if (msg.setupComplete) {
    ready = true;
    setStatus("Clara ouvindo — fale quando quiser");
    log("setupComplete recebido");
    ws.send(JSON.stringify({ realtimeInput: { text: gatilho() } }));
    return;
  }
  const sc = msg.serverContent;
  if (sc) {
    const parts = sc.modelTurn && sc.modelTurn.parts;
    if (parts) {
      for (const p of parts) {
        if (p.inlineData && p.inlineData.data) tocaAudio(p.inlineData.data);
      }
    }
    if (sc.turnComplete) falas++;
    if (sc.interrupted) { paraAudio(); setStatus("Clara ouvindo"); log("áudio interrompido"); }
    return;
  }
  log("evento recebido: " + Object.keys(msg).join(", "));
}

function setBotao(rodando) {
  $("btn-label").textContent = rodando ? "Encerrar conversa" : "Falar com a Clara";
  $("btn").classList.toggle("stop", rodando);
  $("voice-visualizer").classList.toggle("is-listening", rodando);
  $("clara-painel").classList.toggle("conversando", rodando); // com a Clara conduzindo, os atalhos do painel saem de cena
}

function resetaTela() {
  limpaLead();
  modeloFalou = false;
  falas = 0;
  resetaVisualizador();
}

async function inicia() {
  $("btn").disabled = true;
  resetaTela();
  try {
    setStatus("Gerando token...");
    const r = await fetch("/api/live-token", { method: "POST" });
    const d = await r.json();
    if (!r.ok || !d.token) throw new Error("token: " + JSON.stringify(d).slice(0, 200));

    setStatus("Pedindo acesso ao microfone...");
    micStream = await navigator.mediaDevices.getUserMedia({
      audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true, autoGainControl: true },
    });

    playCtx = new AudioContext({ sampleRate: 24000 });
    await playCtx.resume();
    micCtx = new AudioContext();
    const url = URL.createObjectURL(new Blob([WORKLET], { type: "application/javascript" }));
    await micCtx.audioWorklet.addModule(url);
    node = new AudioWorkletNode(micCtx, "cap");
    micCtx.createMediaStreamSource(micStream).connect(node);
    node.port.onmessage = (e) => {
      atualizaVisualizador(e.data);
      if (ws && ws.readyState === WebSocket.OPEN && ready) {
        ws.send(JSON.stringify({ realtimeInput: { audio: { data: toB64(e.data), mimeType: "audio/pcm;rate=16000" } } }));
      }
    };

    setStatus("Conectando à Clara...");
    ws = new WebSocket(`${WS_BASE}?access_token=${encodeURIComponent(d.token)}`);
    ws.onopen = () => {
      log("WebSocket aberto; enviando setup");
      ws.send(JSON.stringify({
        setup: {
          model: MODEL,
          generationConfig: { responseModalities: ["AUDIO"] },
          systemInstruction: { parts: [{ text: SYSTEM_PROMPT }] },
          tools: TOOLS,
          realtimeInputConfig: {
            automaticActivityDetection: { startOfSpeechSensitivity: "START_SENSITIVITY_LOW", endOfSpeechSensitivity: "END_SENSITIVITY_LOW" },
          },
        },
      }));
    };
    ws.onmessage = (ev) => {
      queue = queue.then(async () => {
        try {
          const txt = typeof ev.data === "string" ? ev.data : await ev.data.text();
          trata(JSON.parse(txt));
        } catch (e) { log("erro ao processar mensagem: " + e.message); }
      });
    };
    ws.onerror = () => log("erro no WebSocket");
    ws.onclose = (ev) => {
      log(`WebSocket fechado: código ${ev.code} motivo: ${ev.reason || "(vazio)"}`);
      if (running) para("Conversa encerrada (veja o log técnico)");
    };

    running = true;
    setBotao(true);
    $("btn").disabled = false;
  } catch (e) {
    log("falha ao iniciar: " + e.message);
    para("Erro ao iniciar (veja o log técnico)");
  }
}

function para(texto) {
  running = false;
  ready = false;
  try { if (ws) ws.close(); } catch (e) {}
  try { if (node) node.disconnect(); } catch (e) {}
  if (micStream) micStream.getTracks().forEach((t) => t.stop());
  try { if (micCtx) micCtx.close(); } catch (e) {}
  paraAudio();
  try { if (playCtx) playCtx.close(); } catch (e) {}
  ws = micStream = micCtx = playCtx = node = null;
  setBotao(false);
  resetaVisualizador();
  $("btn").disabled = false;
  setStatus(texto || "Parado");
  if (/^Erro/.test(texto || "")) abrirPainel(); // erro (ex.: microfone negado): mostra o painel com o aviso
}

$("btn").addEventListener("click", () => (running ? para("Parado") : inicia()));
