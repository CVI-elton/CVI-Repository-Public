/* ----- visões, câmera e ambientes ----- */
function mostraView(id) {
  document.querySelectorAll(".view").forEach((v) => v.classList.toggle("ativa", v.id === id));
  $("topo").classList.toggle("solido", id !== "v-inicio");
  document.body.dataset.amb = CATEGORIAS[estado.secao] ? estado.secao : "inicio"; // cor do ambiente por categoria
  window.scrollTo({ top: 0, behavior: "instant" });
}
const reduz = matchMedia("(prefers-reduced-motion: reduce)").matches;
// Transição como câmera: o card escolhido (origem) se expande até virar a cena; sem origem, a câmera avança sobre a cena.
function transicao(fn, origem) {
  if (!document.startViewTransition || reduz) { fn(); return; }
  if (origem) origem.style.viewTransitionName = "cena";
  const t = document.startViewTransition(() => {
    fn();
    const alvo = document.querySelector(".view.ativa .faixa-topo, .view.ativa .cena-alvo");
    if (origem && alvo) alvo.style.viewTransitionName = "cena";
  });
  t.finished.finally(() => document.querySelectorAll('[style*="view-transition-name"]').forEach((e) => { e.style.viewTransitionName = ""; }));
}
function navega(fn, op) {
  limpaFoco(); limpaSugestoes();
  transicao(() => { fechaExplorar(); fn(); if (op.guiado) marcaGuiada(); }, op.origem || null);
}
function descricao() {
  if (estado.procedimento) { const p = todasProcs().find((x) => x.id === estado.procedimento); return `Detalhes de ${p.nome} (${CATEGORIAS[p.categoria].titulo}): ${p.detalhe} Na tela há quatro blocos numerados em "Como funciona": 1 O que é, 2 Como costuma funcionar, 3 Indicação, 4 Valores e condições. Use destacar_bloco para apontar cada um enquanto explica.`; }
  if (CATEGORIAS[estado.secao]) { const d = CATEGORIAS[estado.secao]; return `${d.titulo}. Procedimentos na tela: ${d.procedimentos.map((p) => `${p.nome} (id ${p.id})`).join(", ")}.`; }
  if (estado.secao === "clinica") return `Conheça a clínica. Na tela: ambientes (${AMBIENTES.map((a) => a.nome).join(", ")}) e os diferenciais da ÉLORA.`;
  if (estado.secao === "contato") return "Contato: convite para falar com a Clara e solicitar uma avaliação.";
  return "Início: imagem de boas-vindas com os botões Deixe a Clara conduzir e Explorar sozinho(a).";
}
function abrirSecao(secao, op = {}) {
  if (!SECOES.includes(secao)) return { ok: false, erro: "secao_invalida" };
  estado.secao = secao; estado.procedimento = null;
  const origem = op.origem || document.querySelector(`#sugestoes [data-ir="${secao}"]`);
  navega(() => {
