let analisador = null, dadosAnalise = null, animando = false, suave = 0;
function saidaAnalisador() {
  if (!analisador || analisador.context !== playCtx) {
    analisador = playCtx.createAnalyser(); analisador.fftSize = 512;
    analisador.connect(playCtx.destination); dadosAnalise = new Uint8Array(analisador.fftSize);
  }
  if (!animando) { animando = true; requestAnimationFrame(animaFala); }
  return analisador;
}
function animaFala() {
  if (!running && !sources.length) { animando = false; return; }
  const esfera = $("voice-visualizer"), raiz = document.documentElement.style;
  if (sources.length && analisador) {
    analisador.getByteTimeDomainData(dadosAnalise);
    let soma = 0;
    for (let i = 0; i < dadosAnalise.length; i++) { const v = (dadosAnalise[i] - 128) / 128; soma += v * v; }
    suave += (Math.min(1, Math.sqrt(soma / dadosAnalise.length) * 5) - suave) * 0.25;
    raiz.setProperty("--voice-scale", (1 + suave * 0.22).toFixed(3));
    raiz.setProperty("--nivel", suave.toFixed(3));
    esfera.classList.add("is-active", "falando");
  } else if (esfera.classList.contains("falando")) {
    suave = 0; raiz.setProperty("--nivel", "0"); esfera.classList.remove("falando");
  }
  requestAnimationFrame(animaFala);
}

