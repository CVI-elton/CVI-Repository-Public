@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=DM+Sans:wght@400;500;600&display=swap');

:root{--verde:#1f3d30;--verde2:#2f5a43;--salvia:#8fa48c;--bege:#efe3d1;--off:#faf6ee;--pessego:#f0c9a0;--tinta:#25302a;--mudo:#5d675f;--linha:#e3d8c6;--serif:'Cormorant Garamond',Georgia,serif;--sans:'DM Sans',Arial,sans-serif;--pad:max(5%,calc((100% - 1120px)/2))}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{margin:0;background:var(--off);color:var(--tinta);font-family:var(--sans);line-height:1.6;-webkit-font-smoothing:antialiased;padding-bottom:env(safe-area-inset-bottom)}
button{font:inherit;color:inherit;cursor:pointer}
em{font-style:italic}
:focus-visible{outline:2px solid var(--pessego);outline-offset:3px}
h1,h2,h3{font-family:var(--serif);font-weight:500;margin:0;line-height:1.1}

/* Topo */
.logo{display:grid;grid-template-columns:auto auto;column-gap:10px;align-items:center;background:none;border:0;padding:0;text-align:left;color:inherit}
.logo svg{grid-row:1/3}
.logo-nome{font:500 28px/1 var(--serif);letter-spacing:4px}
.logo-sub{font-size:9px;letter-spacing:3px;text-transform:uppercase;opacity:.8}
.btn-contorno{padding:10px 18px;border:1px solid currentColor;border-radius:99px;background:none;font-size:14px;font-weight:500;color:inherit;transition:background .2s,color .2s}
.btn-contorno:hover{background:var(--bege);color:var(--verde)}
.btn-contorno.escuro{color:var(--verde)}
.btn-contorno.escuro:hover{background:var(--verde);color:var(--off)}
.btn-bege,.btn-verde{display:inline-flex;justify-content:center;gap:10px;padding:15px 30px;border:0;border-radius:99px;font-size:16px;font-weight:500;transition:transform .2s,background .2s}
.btn-bege{background:var(--bege);color:var(--verde)}
.btn-bege:hover{transform:translateY(-2px);background:#f5ead9}
.btn-verde{background:var(--verde2);color:#fff;width:100%}
.btn-verde:hover{background:var(--verde)}
.btn-verde:disabled{opacity:.6;cursor:wait}
.btn-verde.stop{background:#8a503c}

/* Visões */
.view{display:none}
.view.ativa{display:block;animation:entra .5s ease both}
.view.ativa .card,.view.ativa .proc,.view.ativa .amb,.view.ativa .difs li{animation:sobe .7s cubic-bezier(.2,.7,.2,1) backwards;animation-delay:calc(var(--i,0)*80ms + 120ms)}
.faixa-topo .foto{animation:pan 18s ease-in-out infinite alternate}
@keyframes pan{from{background-position:42% 50%}to{background-position:62% 50%}}
.view.guiada{position:relative}
.view.guiada:before{content:"";position:absolute;left:0;right:0;top:0;height:3px;z-index:5;background:linear-gradient(90deg,transparent,var(--pessego),#9fd3a8,transparent) no-repeat;background-size:50% 100%;animation:varre 1.3s ease-out both}
@keyframes varre{from{background-position:-60% 0;opacity:1}to{background-position:160% 0;opacity:0}}
.view.guiada .faixa-topo h1{animation:brilho 1.4s ease}
@keyframes brilho{40%{text-shadow:0 0 26px rgba(240,201,160,.75)}}
.clara{view-transition-name:clara}
@keyframes entra{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

/* Início */
@keyframes zoomLento{to{transform:scale(1.08) translate(-1.5%,0)}}
@keyframes sobe{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
.hero-texto>*{animation:sobe .9s cubic-bezier(.2,.7,.2,1) backwards}
.hero-texto>:nth-child(2){animation-delay:.2s}
.hero-texto>:nth-child(3){animation-delay:.4s}
.hero-texto{max-width:520px;color:#f7f1e6}
.hero h1{font-size:clamp(42px,6vw,72px);letter-spacing:-1px}
.hero h1 em{color:var(--pessego)}
.hero p{font-size:19px;margin:20px 0 30px;opacity:.95}
.eyebrow{margin:0 0 10px;font-size:12px;letter-spacing:5px;text-transform:uppercase;color:var(--mudo)}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:34px;text-align:left}
.card{display:flex;flex-direction:column;padding:0;border:0;border-radius:14px;overflow:hidden;background:var(--bege);text-align:left;box-shadow:0 8px 24px rgba(31,61,48,.08);transition:transform .25s,box-shadow .25s}
.card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(31,61,48,.16)}
.foto{background:linear-gradient(135deg,var(--salvia),#d8cdb8) center/cover no-repeat}
.card .foto{height:170px}
.card-txt{padding:14px 16px 18px}
.card-txt strong{display:block;font-size:15px}
.card-txt span{font-size:13px;color:var(--mudo)}
.difs{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;list-style:none;padding:0;margin:22px 0 26px}
.difs li{padding:12px 14px;border-left:2px solid var(--salvia);font-size:14px}
.difs strong{display:block;font-size:15px}

/* Categorias, procedimento, clínica */
.faixa-topo h1{font-size:clamp(36px,5vw,58px)}
.faixa-topo p{margin:0;max-width:480px;opacity:.92}
.faixa-topo .foto{min-height:300px}
.voltar-link{background:none;border:0;padding:0;color:var(--pessego);font-size:14px}
.corpo{padding:50px var(--pad)}
.corpo h2{font-size:clamp(26px,3vw,36px);margin-bottom:22px}
.procs{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:16px}
.proc{display:flex;flex-direction:column;gap:6px;padding:20px;border:1px solid var(--linha);border-radius:14px;background:#fff;text-align:left;transition:border-color .2s,transform .2s}
.proc:hover{border-color:var(--salvia);transform:translateY(-3px)}
.proc strong{font:500 24px/1.1 var(--serif)}
.proc span{font-size:14px;color:var(--mudo)}
.proc i{margin-top:auto;padding-top:8px;font-size:13px;font-style:normal;color:var(--verde2)}
.nota{margin:28px 0 0;font-size:13px;color:var(--mudo);max-width:640px}
.det{display:grid;grid-template-columns:1fr 1fr;gap:30px;align-items:start}
.det .foto{min-height:320px;border-radius:16px}
.det p{margin:0 0 14px}
.ambientes{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:18px}
.amb{border-radius:14px;overflow:hidden;background:var(--bege)}
.amb .foto{height:190px;display:grid;place-items:center;color:var(--verde2);font:italic 500 22px var(--serif)}
.amb div:last-child{padding:14px 16px 18px}
.amb strong{display:block;font:500 22px var(--serif)}
.amb span{font-size:13px;color:var(--mudo)}
.acoes{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}

/* Rodapé */
.rodape{display:grid;grid-template-columns:auto 1fr;gap:10px 34px;align-items:center;padding:36px var(--pad) calc(36px + 70px);background:var(--verde);color:#e8e1d2;border-top:1px solid rgba(255,255,255,.12)}
.rodape-marca{display:grid}
.lema{margin:0;font:italic 500 22px var(--serif)}
.aviso{grid-column:1/3;margin:6px 0 0;font-size:12px;opacity:.7;max-width:760px}

/* Clara */
.clara{position:fixed;right:max(18px,env(safe-area-inset-right));bottom:max(18px,env(safe-area-inset-bottom));z-index:40;display:flex;flex-direction:column;align-items:flex-end;gap:14px}
.clara-esfera{position:relative;width:68px;height:68px;border:0;border-radius:50%;padding:0;background:none;transform:scale(var(--voice-scale,1));transition:transform 80ms linear}
.nucleo{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 34% 28%,#e6f1df,#86ab8b 38%,#2f5a43 78%);box-shadow:0 8px 24px rgba(31,61,48,.45),0 0 calc(var(--nivel,0)*46px) rgba(var(--glow,150,220,160),.85),inset -6px -8px 14px rgba(0,0,0,.25)}
.clara-esfera.falando:before,.clara-esfera.falando:after{animation-duration:1.6s;border-color:rgba(190,230,190,.85)}
.clara-esfera.gesto .nucleo{animation:gesto .9s ease-out}
@keyframes gesto{0%{box-shadow:0 0 0 0 rgba(150,220,160,.8)}100%{box-shadow:0 0 0 36px rgba(150,220,160,0)}}
.clara-esfera.novo .nucleo:after{content:"";position:absolute;top:1px;right:1px;width:14px;height:14px;border-radius:50%;background:var(--pessego);border:2px solid #fff}
.clara-pill{align-self:flex-end;margin-right:4px;padding:6px 12px;border-radius:99px;background:rgba(31,61,48,.92);color:#f4efe4;font-size:12px;box-shadow:0 6px 18px rgba(31,61,48,.3);animation:sobe .4s ease both}
.clara-pill[hidden],.clara-painel.aberto+.clara-pill{display:none}
.clara-esfera:before,.clara-esfera:after{content:"";position:absolute;inset:-9px;border-radius:50%;border:1px solid rgba(143,184,150,.55);animation:anel 3.2s ease-in-out infinite}
.clara-esfera:after{inset:-19px;animation-delay:1.1s;border-color:rgba(143,184,150,.3)}
@keyframes anel{50%{transform:scale(1.07);opacity:.5}}
.clara-esfera.is-active:before,.clara-esfera.is-active:after{border-color:rgba(190,230,190,.9)}
.clara-painel{display:flex;opacity:0;visibility:hidden;pointer-events:none;transform:translateY(14px) scale(.97);transform-origin:100% 100%;transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1),visibility 0s .45s;width:min(370px,calc(100vw - 36px));max-height:calc(100vh - 150px);overflow:auto;padding:18px;border-radius:20px;background:rgba(250,246,238,.97);backdrop-filter:blur(10px);border:1px solid var(--linha);box-shadow:0 18px 50px rgba(31,61,48,.28);flex-direction:column;gap:12px}
.clara-painel.aberto{opacity:1;visibility:visible;pointer-events:auto;transform:none;transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1),visibility 0s}
.clara-topo{display:flex;justify-content:space-between;align-items:flex-start}
.clara-topo strong{display:block;font:500 26px/1 var(--serif)}
.clara-topo small{font-size:12px;color:var(--mudo)}
.clara-min{width:30px;height:30px;border:1px solid var(--linha);border-radius:50%;background:none;font-size:18px;line-height:1}
.clara-boasvindas{margin:0;font-size:14px}
.clara-estado{display:block;min-height:1.4em;font-size:13px;color:var(--mudo);text-align:center}
.clara-atalhos{display:flex;flex-wrap:wrap;gap:8px}
.clara-atalhos button{padding:9px 14px;border:1px solid var(--linha);border-radius:99px;background:#fff;font-size:13px;transition:background .2s}
.clara-atalhos button:hover{background:var(--bege)}
.clara-atalhos .voltar{border-style:dashed}
.clara-nota{margin:0;font-size:11px;line-height:1.5;color:var(--mudo)}
.log{font-size:10px;color:var(--mudo)}
.log pre{max-height:160px;margin:6px 0 0;padding:8px;overflow:auto;white-space:pre-wrap;background:#25302a;color:#dfe7da;border-radius:6px}
.resumo{padding:14px;border-left:3px solid var(--verde2);background:var(--bege);border-radius:0 10px 10px 0}
.resumo h3{font-size:20px;margin-bottom:8px}
.resumo dl{margin:0 0 12px;display:grid;gap:8px}
.resumo dt{font-size:11px;font-weight:600;color:var(--mudo)}
.resumo dd{margin:0;font-size:14px;overflow-wrap:anywhere}
.zap{display:flex;justify-content:center;padding:12px;border-radius:99px;background:#2e6b4a;color:#fff;font-weight:500;font-size:14px;text-decoration:none}
.zap:hover{background:#245a3e}
.resumo small{display:block;margin-top:8px;font-size:11px;color:var(--mudo)}
.debug{position:fixed;left:10px;bottom:10px;z-index:50;display:flex;flex-wrap:wrap;gap:4px;max-width:60vw;padding:8px;background:#fff;border:1px dashed #999;border-radius:8px;font-size:11px}
.debug[hidden]{display:none}
.debug button{padding:3px 7px;font-size:11px}

/* Responsivo */
@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .view.ativa{animation:none}
  .clara-esfera,.card,.proc{transition:none}
  .clara-esfera:before,.clara-esfera:after{animation:none}
  .hero:before,.hero-texto>*,.faixa-topo .foto,.view.ativa .card,.view.ativa .proc,.view.ativa .amb,.view.ativa .difs li,.view.guiada:before,.view.guiada .faixa-topo h1,.clara-esfera.gesto .nucleo,.clara-pill,.chip,.bloco{animation:none}
  .clara-painel,.clara-painel.aberto{transition:none}
}

/* ===== v2: cenas, ambientes, câmera, foco ===== */
:root{--amb1:#1f3d30;--amb2:#2f5a43;--acc:#f0c9a0;--glow:150,220,160}
body[data-amb=facial]{--amb1:#5a3829;--amb2:#c08b68;--acc:#f8d8bc;--glow:255,205,165}
body[data-amb=corporal]{--amb1:#2b4a39;--amb2:#78967b;--acc:#d6e8cd;--glow:190,230,180}
body[data-amb=tecnologia]{--amb1:#1b3a4a;--amb2:#4f8399;--acc:#c4e4f1;--glow:160,215,240}
body.sem-rolagem{overflow:hidden}
.topo{position:fixed;left:0;right:0;top:0;z-index:30;display:flex;align-items:center;justify-content:space-between;padding:14px var(--pad);padding-top:calc(14px + env(safe-area-inset-top));color:#f4efe4;background:transparent;transition:background .5s,box-shadow .5s,filter .5s;view-transition-name:topo}
.topo.solido{background:var(--amb1);box-shadow:0 6px 24px rgba(0,0,0,.2)}
body.foco .topo{filter:brightness(.55)}
.hero{position:relative;isolation:isolate;overflow:hidden;min-height:100svh;display:flex;align-items:flex-end;padding:120px var(--pad) 120px;background:var(--verde)}
.hero:before{content:"";position:absolute;inset:-4%;z-index:-2;background:url(images/hero.jpg) right center/cover no-repeat,linear-gradient(120deg,#1f3d30,#8fa48c);animation:zoomLento 24s ease-in-out infinite alternate}
.hero:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(31,61,48,.96) 0%,rgba(31,61,48,.78) 38%,rgba(31,61,48,.05) 75%),linear-gradient(0deg,rgba(31,61,48,.7),transparent 40%)}
.acoes-hero{display:flex;flex-wrap:wrap;gap:14px;align-items:center}
.hero-texto .btn-contorno{padding:15px 26px;font-size:16px;color:#f7f1e6}
.faixa-topo{display:grid;grid-template-columns:1.1fr 1fr;min-height:420px;padding-top:68px;background:linear-gradient(120deg,var(--amb1),var(--amb2));color:#f4efe4}
.faixa-topo .txt{padding:48px var(--pad);display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:14px}
.voltar-link{color:var(--acc)}
.proc:hover{border-color:var(--amb2)}
.proc i{color:var(--amb2)}
.blocos{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;position:relative}
.bloco{padding:22px 20px;border-radius:16px;background:#fff;border:1px solid var(--linha);transition:opacity .6s,transform .6s cubic-bezier(.2,.8,.2,1),box-shadow .6s}
.bloco b{display:block;margin-bottom:6px;font:italic 500 36px/1 var(--serif);color:var(--amb2)}
.bloco strong{display:block;margin-bottom:6px;font:500 23px/1.1 var(--serif)}
.bloco span{font-size:14px;color:var(--mudo)}
.view.ativa .bloco{animation:sobe .7s cubic-bezier(.2,.7,.2,1) backwards;animation-delay:calc(var(--i,0)*100ms + 150ms)}
.view{position:relative}
.view.foco:after{content:"";position:absolute;inset:0;z-index:5;background:rgba(8,20,14,.62);pointer-events:none;animation:fade .6s ease both}
@keyframes fade{from{opacity:0}}
.blocos.tem-foco{z-index:6}
.blocos.tem-foco .bloco{opacity:.3;transform:scale(.97)}
.blocos.tem-foco .bloco.aceso{opacity:1;transform:none;box-shadow:0 0 0 1px var(--acc),0 16px 40px rgba(0,0,0,.3)}
.blocos.tem-foco .bloco.atual{transform:scale(1.04);box-shadow:0 0 0 2px var(--acc),0 0 44px rgba(var(--glow),.55),0 20px 50px rgba(0,0,0,.35)}
.contato-cena{min-height:100svh;display:grid;place-content:center;justify-items:center;text-align:center;padding:110px var(--pad);background:linear-gradient(160deg,var(--amb1),var(--amb2));color:#f4efe4}
.contato-cena h2{font-size:clamp(34px,5vw,58px);max-width:760px}
.contato-cena p{max-width:520px;margin:14px 0 28px;opacity:.92}
.sugestoes{position:fixed;left:max(16px,env(safe-area-inset-left));right:104px;bottom:max(20px,env(safe-area-inset-bottom));z-index:35;display:flex;flex-wrap:wrap;gap:10px;justify-content:center;pointer-events:none}
.chip{pointer-events:auto;padding:12px 20px;border:1px solid rgba(255,255,255,.55);border-radius:99px;background:rgba(31,61,48,.8);backdrop-filter:blur(10px);color:#fff;font-size:15px;box-shadow:0 8px 22px rgba(0,0,0,.25);animation:sobe .6s cubic-bezier(.2,.7,.2,1) backwards;animation-delay:calc(var(--i,0)*120ms);transition:background .2s,color .2s}
.chip:hover{background:var(--acc);color:#25302a}
.chip.sai{animation:some .4s ease forwards;pointer-events:none}
@keyframes some{to{opacity:0;transform:translateY(10px) scale(.95)}}
.explorar{position:fixed;inset:0;z-index:35;padding:96px var(--pad) 40px;overflow:auto;background:rgba(18,38,29,.95);backdrop-filter:blur(16px);color:#f4efe4;opacity:0;visibility:hidden;transition:opacity .4s,visibility 0s .4s}
.explorar.aberto{opacity:1;visibility:visible;transition:opacity .4s}
.explorar .eyebrow{color:#cfd9c9}
.explorar h2{font-size:clamp(30px,4vw,48px);margin:6px 0 26px}
.explorar-fechar{position:absolute;top:calc(16px + env(safe-area-inset-top));right:max(18px,var(--pad));width:44px;height:44px;border:1px solid rgba(255,255,255,.4);border-radius:50%;background:none;font-size:26px;line-height:1;color:#fff}
.explorar-extra{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.explorar.aberto .card{animation:sobe .6s cubic-bezier(.2,.7,.2,1) backwards;animation-delay:calc(var(--i,0)*90ms + 150ms)}
::view-transition-old(root){animation:camSai .5s cubic-bezier(.4,0,.2,1) both}
::view-transition-new(root){animation:camEntra .8s cubic-bezier(.2,.8,.2,1) both}
@keyframes camSai{to{opacity:0;transform:scale(1.05)}}
@keyframes camEntra{from{opacity:0;transform:scale(.96)}}
::view-transition-group(cena){animation-duration:.8s;animation-timing-function:cubic-bezier(.2,.8,.2,1)}
::view-transition-old(cena),::view-transition-new(cena){height:100%;object-fit:cover}
@media(max-width:960px){
  .cards{grid-template-columns:repeat(2,1fr)}
  .faixa-topo,.det{grid-template-columns:1fr}
  .faixa-topo .foto{order:-1;min-height:220px}
}
@media(max-width:760px){
  .topo{padding:10px 14px;padding-top:calc(10px + env(safe-area-inset-top))}
  .logo svg{width:34px;height:22px}
  .logo-nome{font-size:22px;letter-spacing:3px}
  .logo-sub{font-size:8px;letter-spacing:2px}
  .topo .btn-contorno{padding:7px 14px;font-size:13px}
  .hero{padding:110px 20px 130px}
  .hero:before{background-position:72% top}
  .hero:after{background:linear-gradient(180deg,rgba(31,61,48,.25) 0%,rgba(31,61,48,.55) 45%,rgba(31,61,48,.96) 100%)}
  .card .foto{height:110px}
  .cards{gap:12px}
  .difs{grid-template-columns:1fr}
  .rodape{grid-template-columns:1fr}
  .aviso{grid-column:1}
  .sugestoes{right:80px;left:12px;justify-content:flex-start}
  .chip{padding:10px 16px;font-size:14px}
  .clara{right:12px;bottom:max(12px,env(safe-area-inset-bottom))}
  .clara-painel{width:calc(100vw - 24px);max-height:58vh;padding:14px; display:none;}
  .clara-painel.aberto{display:block;}
  .clara-esfera{width:58px;height:58px}
}
@media(prefers-reduced-motion:reduce){
  .chip,.bloco,.view.ativa .bloco,.hero-texto>*,.explorar.aberto .card{animation:none}
  .explorar,.explorar.aberto,.bloco,.topo{transition:none}
}

.clara-painel.conversando .clara-atalhos{display:none}
